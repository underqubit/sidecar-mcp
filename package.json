{
  "name": "underqubit-sidecar-mcp",
  "version": "1.0.0",
  "description": "Configurable MCP server for REST APIs and local CLIs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "underqubit-sidecar-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc --noEmit",
    "start": "node dist/cli.js",
    "dev": "npm run build && node --enable-source-maps dist/cli.js",
    "test": "npm run build && vitest run",
    "test:network": "npm run build && vitest run --config vitest.network.config.ts",
    "schema": "npm run build && node scripts/generate-schema.mjs",
    "check": "npm run build && tsc --noEmit && vitest run",
    "prepack": "node scripts/prepare-package.mjs",
    "prepublishOnly": "npm run check",
    "check:package": "node scripts/check-package.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check-schema": "npm run build && node scripts/check-json-schema-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.18.1",
    "jsonata": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.13.2",
    "marked": "18.0.6",
    "nock": "^14.0.16",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rest",
    "cli",
    "openapi",
    "tools",
    "typescript"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "schema/config.schema.json",
    "README.es.md",
    "docs/**/*.md",
    "skills/underqubit-sidecar-mcp/SKILL.md",
    "skills/underqubit-sidecar-mcp/agents/openai.yaml",
    "examples/auth.yaml",
    "examples/cli.json",
    "examples/cli.yaml",
    "examples/composition.json",
    "examples/composition.yaml",
    "examples/echo.mjs",
    "examples/http.yaml",
    "examples/openapi/*.yaml",
    "scripts/openapi-to-config.mjs",
    "scripts/openapi2-to-config.mjs",
    "scripts/openapi3-to-config.mjs",
    "scripts/lib/openapi-*.mjs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
